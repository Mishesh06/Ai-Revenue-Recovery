# ── Active Database & Application Configuration ─────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai_test

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8001
SECRET_KEY=change-this-in-production

# ── LLM Integration Configuration ──────────────────────────────
# Supported providers: "mock" (default, offline), "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=mock
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=2.0
# LLM_MAX_TOKENS=300
# LLM_TEMPERATURE=0.0

# ── Gateway Integration (Action Adapters) ──────────────────────
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
FRONTEND_URL=http://localhost:3000
